---
/**
 * Site header (Figma 903:655) — 77px bar, 1px #272727 bottom rule, bold 18/28 uppercase.
 * Fixed; hides on scroll down / reveals on scroll up (scripts/animations/header.ts).
 * Switches to the accent surface while the INDEX menu is open (html[data-menu-open]).
 */
import { site } from '@/data/site';
---

<header
  data-header
  data-reveal="custom"
  class="gutter-x fixed inset-x-0 top-0 z-50 flex h-header items-center justify-between border-b border-line bg-ink font-display text-label-sm font-bold text-white uppercase transition-colors duration-500 will-change-transform lg:text-label in-data-menu-open:border-ink/25 in-data-menu-open:bg-accent in-data-menu-open:text-ink"
>
  <a href="#start" class="link-underline" aria-label={`${site.name} — początek strony`}>
    {site.name}
  </a>

  <nav aria-label="Główna nawigacja" class="flex items-center gap-6 lg:gap-10">
    <a href={site.consultationUrl} class="link-underline hidden sm:inline">
      Konsultacja
    </a>
    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="index-menu"
      class="group inline-flex items-center gap-[0.35em] uppercase"
    >
      <span data-menu-toggle-label>Index</span>
      <span
        aria-hidden="true"
        class="inline-block transition-transform duration-500 ease-out-expo group-aria-expanded:rotate-[135deg]"
      >
        +
      </span>
    </button>
  </nav>
</header>
