---
/**
 * Footer: Figma 901:644 (253px min, 1px #272727 top rule). Middle column at 50% - 20px (x=700,
 * aligned with the "Początek" content column). Grid, not absolute columns: the footer grows with
 * the socials list and always keeps its 40px bottom padding (Figma's 253px was sized for 4 links).
 */
import { site } from '@/data/site';
import EmailLink from '@/components/ui/EmailLink.astro';

const year = new Date().getFullYear();
---

<footer class="gutter-x relative grid gap-10 border-t border-line bg-ink pt-10 pb-16 font-display text-label-sm text-paper uppercase lg:min-h-[15.8125rem] lg:grid-cols-[calc(50%-1.25rem)_1fr_auto] lg:items-start lg:gap-0 lg:pb-10 lg:text-label">
  <p>
    {year} © {site.name}
  </p>

  <ul class="flex flex-col gap-4">
    {site.socials.map((social) => (
      <li>
        <a href={social.href} target="_blank" rel="noopener" class="link-underline">
          {social.label}
          <span class="sr-only"> (otwiera się w nowej karcie)</span>
        </a>
      </li>
    ))}
    <li>
      <EmailLink class="link-underline" />
    </li>
  </ul>

  <p class="lg:text-right">
    Stworzone z miłością
    <br />
    przez
    <a
      href={site.auraflux.footerUrl}
      target="_blank"
      rel="noopener"
      class="underline decoration-from-font underline-offset-auto transition-colors duration-300 hover:text-accent"
    >
      Auraflux.pl
    </a>
  </p>
</footer>
