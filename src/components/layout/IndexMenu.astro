---
/**
 * "INDEX +" overlay — full-screen section index. Opened/closed by scripts/animations/menu.ts.
 * Hidden with `hidden` until opened, so it is out of the a11y tree and tab order.
 * Accent surface with ink typography on every breakpoint.
 */
import { sections, site } from '@/data/site';
---

<div
  id="index-menu"
  data-menu
  role="dialog"
  aria-modal="true"
  aria-label="Index sekcji"
  hidden
  class="fixed inset-0 z-40 flex flex-col bg-accent pt-header text-ink [clip-path:inset(0_0_100%_0)]"
  data-lenis-prevent
>
  <nav aria-label="Sekcje strony" class="gutter-x flex flex-1 flex-col justify-center lg:px-inset">
    <ol class="flex flex-col">
      {sections.map((section, index) => (
        <li class="overflow-hidden border-b border-ink/25 first:border-t">
          <a
            href={`#${section.id}`}
            data-menu-link
            class="group flex items-baseline gap-6 py-3 font-display text-h2-sm font-bold uppercase transition-colors duration-300 focus-visible:outline-ink hover:text-paper lg:gap-10 lg:py-4 lg:text-h2"
          >
            <span class="font-normal text-ink/60 text-label-sm lg:text-label">
              _{String(index + 1).padStart(2, '0')}
            </span>
            <span class="inline-block transition-transform duration-500 ease-out-expo group-hover:translate-x-4">
              {section.label}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="gutter-x flex flex-wrap items-center justify-between gap-4 border-t border-ink/25 py-6 font-display text-label-sm text-ink uppercase lg:text-label">
    <span class="hidden lg:inline">#1metrDalej</span>
    <!-- Mobile: the header hides "Konsultacja" below sm, so it lives here -->
    <a
      href={site.consultationUrl}
      data-menu-link
      class="link-underline font-bold focus-visible:outline-ink lg:hidden"
    >
      Konsultacja
    </a>
    <ul class="flex gap-6 lg:gap-10">
      {site.socials.map((social) => (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="noopener"
            class="link-underline focus-visible:outline-ink hover:text-paper"
          >
            {social.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
