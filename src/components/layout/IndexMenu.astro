---
/**
 * "INDEX +" overlay: full-screen section index. Opened/closed by scripts/animations/menu.ts.
 * Hidden with `hidden` until opened, so it is out of the a11y tree and tab order.
 * Accent surface with ink typography on every breakpoint. Wide desktop screens (aspect ≥ 3:2:
 * laptops, 16:9 monitors), where the rem-scaled rows would outgrow the height, get compact rows;
 * if it still does not fit, the overlay scrolls (data-lenis-prevent).
 */
import { sections, site } from '@/data/site';
import EmailLink from '@/components/ui/EmailLink.astro';
import { sectionHref } from '@/lib/seo';

// Internal previews with the offer module list it after "Buduję"
const items: { id: string; label: string }[] = Astro.locals.offerSection
  ? sections.flatMap((section) =>
      section.id === 'buduje' ? [section, { id: 'warsztat', label: 'Warsztat' }] : [section],
    )
  : [...sections];
---

<div
  id="index-menu"
  data-menu
  role="dialog"
  aria-modal="true"
  aria-label="Index sekcji"
  hidden
  class="fixed inset-0 z-40 flex flex-col overflow-y-auto overscroll-contain bg-accent pt-header text-ink [clip-path:inset(0_0_100%_0)]"
  data-lenis-prevent
>
  <nav aria-label="Sekcje strony" class="gutter-x flex flex-1 flex-col lg:px-inset">
    {/* my-auto: centred when it fits, scrollable from the top when it does not */}
    <ol class="my-auto flex flex-col py-6">
      {items.map((section, index) => (
        <li class="overflow-hidden border-b border-ink/25 first:border-t">
          <a
            href={sectionHref(section.id, Astro.url.pathname, Astro.locals.homeSections)}
            data-menu-link
            class="group flex items-baseline gap-6 py-3 font-display text-h2-sm font-bold uppercase transition-colors duration-300 focus-visible:outline-ink hover:text-paper lg:gap-10 lg:py-4 lg:text-h2 [@media(min-width:64rem)_and_(min-aspect-ratio:3/2)]:py-2 [@media(min-width:64rem)_and_(min-aspect-ratio:3/2)]:text-h3"
          >
            <span class="font-normal text-ink/60 text-label-sm lg:text-label">
              _{String(index + 1).padStart(2, '0')}
            </span>
            <span class="inline-block transition-transform duration-500 ease-out-expo group-hover:translate-x-4">
              {section.label}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="gutter-x flex flex-wrap items-center justify-between gap-4 border-t border-ink/25 py-6 font-display text-label-sm text-ink uppercase lg:text-label">
    <span class="hidden lg:inline">#1metrDalej</span>
    {/* Mobile: the header hides "Konsultacja" below sm, so it lives here */}
    <a
      href={site.consultationUrl}
      target="_blank"
      rel="noopener"
      data-menu-link
      class="link-underline font-bold focus-visible:outline-ink lg:hidden"
    >
      Konsultacja<span class="sr-only"> (otwiera się w nowej karcie)</span>
    </a>
    <ul class="flex flex-wrap gap-x-6 gap-y-3 lg:gap-x-10">
      {site.socials.map((social) => (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="noopener"
            class="link-underline focus-visible:outline-ink hover:text-paper"
          >
            {social.label}
          </a>
        </li>
      ))}
      <li>
        <EmailLink class="link-underline focus-visible:outline-ink hover:text-paper" />
      </li>
    </ul>
  </div>
</div>
