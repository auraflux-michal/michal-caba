---
/**
 * The home page composition, shared by `/` and its internal previews (/podglad/*).
 * Optional `offer` slot renders between "Buduję" and "Filozofia" (its place on the page).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import IndexMenu from '@/components/layout/IndexMenu.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/sections/Hero.astro';
import About from '@/components/sections/About.astro';
import Roles from '@/components/sections/Roles.astro';
import Build from '@/components/sections/Build.astro';
import Philosophy from '@/components/sections/Philosophy.astro';
import Notes from '@/components/sections/Notes.astro';
import Next from '@/components/sections/Next.astro';

interface Props {
  /** Internal previews: never indexed */
  noindex?: boolean;
  title?: string;
}

const { noindex = false, title } = Astro.props;
Astro.locals.homeSections = true;
Astro.locals.offerSection = Astro.slots.has('offer');
---

<BaseLayout noindex={noindex} title={title}>
  <Fragment slot="header">
    <Header />
    <IndexMenu />
  </Fragment>

  <Hero />
  <About />
  <Roles />
  <Build />
  <slot name="offer" />
  <Philosophy />
  <Notes />
  <Next />

  <Footer slot="footer" />
</BaseLayout>
