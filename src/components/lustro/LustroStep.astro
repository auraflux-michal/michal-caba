---
/**
 * One checklist step: segmented progress (done ink, current accent), title, why, then rows
 * separated by 1px ink rules (Notes rhythm). The whole row toggles; the square checkbox fills
 * accent and an accent rule draws under a ticked row. Navigation lives in LustroNav (sticky).
 */
import type { LustroSection } from '@/data/lustro';

interface Props {
  section: LustroSection;
  index: number;
  total: number;
}

const { section, index, total } = Astro.props;
---

<div data-screen={index} hidden>
  <div class="flex items-baseline justify-between gap-4 font-display text-label-sm uppercase lg:text-label">
    <p class="text-muted">
      Krok <span class="text-ink">{index + 1}</span> z {total}
    </p>
    <p class="text-muted">{section.items.length} punktów</p>
  </div>
  <ol
    class="mt-3 grid gap-1.5"
    style={`grid-template-columns: repeat(${total}, minmax(0, 1fr))`}
    aria-hidden="true"
  >
    {Array.from({ length: total }, (_, i) => (
      <li class:list={['h-1', i < index ? 'bg-ink' : i === index ? 'bg-accent' : 'bg-ink/15']} />
    ))}
  </ol>

  <h2 class="mt-10 font-display text-h2-sm font-bold lg:mt-12 lg:text-h2">{section.title}</h2>
  <p class="mt-4 max-w-[35rem] font-body text-body-sm font-medium text-ink/75 lg:text-body">
    {section.why}
  </p>

  <p class="mt-10 font-display text-label-sm text-muted uppercase lg:text-label">
    Zaznacz to, co już masz
  </p>
  <ul class="mt-3">
    {section.items.map((entry, i) => {
      const id = `${index}-${i}`;
      return (
        <li class="group/item relative border-b border-ink first:border-t">
          <input type="checkbox" id={`lustro-${id}`} data-item={id} class="sr-only" />
          <label
            for={`lustro-${id}`}
            class="grid cursor-pointer grid-cols-[1.75rem_1fr] gap-x-5 py-5 transition-colors duration-300 group-hover/item:bg-ink/[0.03] group-has-checked/item:bg-accent/[0.06] group-has-focus-visible/item:outline-2 group-has-focus-visible/item:outline-offset-2 group-has-focus-visible/item:outline-accent lg:gap-x-6 lg:py-6"
          >
            <span
              data-item-box
              class="mt-0.5 grid size-7 place-items-center border border-ink text-ink transition-colors duration-300 group-has-checked/item:bg-accent"
            >
              <svg
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
                class="size-4 scale-50 opacity-0 transition duration-300 ease-out-expo group-has-checked/item:scale-100 group-has-checked/item:opacity-100"
              >
                <path
                  d="M3 8.5l3.2 3L13 4.8"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="square"
                />
              </svg>
            </span>
            <span>
              <span class="block font-display text-[1.1875rem] leading-snug font-bold lg:text-[1.375rem]">
                {entry.title}
              </span>
              <span class="mt-1 block font-body text-body-sm font-medium text-ink/65">
                {entry.hint}
              </span>
            </span>
          </label>
          <span
            aria-hidden="true"
            class="absolute -bottom-px left-0 h-px w-full origin-left scale-x-0 bg-accent transition-transform duration-700 ease-out-expo group-has-checked/item:scale-x-100"
          />
        </li>
      );
    })}
  </ul>
</div>
