---
/**
 * One checklist step: rows separated by 1px ink rules (same rhythm as Notes), a square checkbox
 * that fills accent when ticked, and an accent rule that draws under a ticked row.
 */
import CtaRow from '@/components/ui/CtaRow.astro';
import LustroProgress from '@/components/lustro/LustroProgress.astro';
import type { LustroSection } from '@/data/lustro';

interface Props {
  section: LustroSection;
  index: number;
  total: number;
}

const { section, index, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const isLast = index === total - 1;
---

<div data-screen={index} hidden>
  <LustroProgress value={index / total} />

  <p class="mt-10 font-display text-label-sm text-muted uppercase lg:mt-14 lg:text-label">
    <span class="text-accent">_{pad(index + 1)}</span>&nbsp;&nbsp;Krok {index + 1} z {total}
  </p>
  <h2 class="mt-4 font-display text-h2-sm font-bold lg:text-h2">{section.title}</h2>
  <p class="mt-6 max-w-[35rem] font-body text-body-sm font-medium lg:text-body">{section.why}</p>

  <ul class="mt-10 lg:mt-12">
    {section.items.map((entry, i) => {
      const id = `${index}-${i}`;
      return (
        <li class="group/item relative border-b border-ink first:border-t">
          <input type="checkbox" id={`lustro-${id}`} data-item={id} class="sr-only" />
          <label
            for={`lustro-${id}`}
            class="grid cursor-pointer grid-cols-[1.75rem_1fr] gap-x-5 py-6 group-has-focus-visible/item:outline-2 group-has-focus-visible/item:outline-offset-2 group-has-focus-visible/item:outline-accent lg:gap-x-8 lg:py-7"
          >
            <span
              data-item-box
              class="mt-0.5 grid size-7 place-items-center border border-ink text-ink transition-colors duration-300 group-hover/item:bg-ink/5 group-has-checked/item:bg-accent"
            >
              <svg
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
                class="size-4 scale-50 opacity-0 transition duration-300 ease-out-expo group-has-checked/item:scale-100 group-has-checked/item:opacity-100"
              >
                <path
                  d="M3 8.5l3.2 3L13 4.8"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="square"
                />
              </svg>
            </span>
            <span class="transition-transform duration-700 ease-out-expo group-hover/item:translate-x-2">
              <span class="block font-display text-lead-sm font-bold lg:text-lead">
                {entry.title}
              </span>
              <span class="mt-1 block font-body text-body-sm font-medium text-ink/65">
                {entry.hint}
              </span>
            </span>
          </label>
          <span
            aria-hidden="true"
            class="absolute -bottom-px left-0 h-px w-full origin-left scale-x-0 bg-accent transition-transform duration-700 ease-out-expo group-has-checked/item:scale-x-100"
          ></span>
        </li>
      );
    })}
  </ul>

  <p
    data-step-counter
    aria-live="polite"
    class="mt-10 text-right font-display text-label-sm text-accent uppercase lg:mt-12 lg:text-label"
  >
    Masz 0 z {section.items.length}
  </p>

  <CtaRow data-lustro-next class="mt-4">
    {isLast ? 'Pokaż mój wynik' : 'Dalej'}
  </CtaRow>
  <button
    type="button"
    data-lustro-back
    class="link-underline mt-2 font-display text-label-sm text-muted uppercase transition-colors hover:text-ink lg:text-label"
  >
    Wstecz
  </button>
</div>
