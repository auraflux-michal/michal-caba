---
/**
 * Newsletter sign-up (ink panel, like "Początek"): name, e-mail, GDPR consent (unticked by
 * default), honeypot. Posts to /api/lustro (MailerLite, double opt-in) via scripts/lustro.
 */
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';

const privacyExternal = site.privacyUrl.startsWith('http');
const label = 'font-display text-label-sm uppercase lg:text-label';
const field =
  'mt-2 w-full rounded-none border-0 border-b border-paper/40 bg-transparent py-3 font-body text-body-sm font-medium text-paper transition-colors duration-300 outline-none placeholder:text-paper/40 focus:border-accent lg:text-body';
---

<div
  id="plan"
  data-signup
  class="scroll-mt-header mt-16 bg-ink px-5 py-10 text-paper lg:mt-24 lg:px-10 lg:py-14"
>
  <div data-signup-form-wrap>
    <p class:list={[label, 'text-accent']}>Plan działania</p>
    <h3 class="mt-4 font-display text-h3-sm font-bold lg:text-h3">Wyślę Ci pełny plan działania</h3>
    <p class="mt-4 max-w-[33rem] font-body text-body-sm font-medium text-paper/80 lg:text-body">
      Wszystkie Twoje puste pola ułożone w kolejności, plus co tydzień jedna praktyczna wskazówka o
      budowaniu marki osobistej.
    </p>

    <form data-signup-form novalidate class="mt-10">
      <div class="grid gap-8 sm:grid-cols-2 sm:gap-6">
        <label class="block">
          <span class:list={[label, 'text-paper/60']}>Imię</span>
          <input
            type="text"
            name="name"
            autocomplete="given-name"
            maxlength="100"
            placeholder="Jak masz na imię?"
            class={field}
          />
        </label>
        <label class="block">
          <span class:list={[label, 'text-paper/60']}>Adres e-mail</span>
          <input
            type="email"
            name="email"
            autocomplete="email"
            required
            maxlength="254"
            placeholder="jan@firma.pl"
            class={field}
          />
        </label>
      </div>

      {/* Honeypot: hidden from people and assistive tech, bots fill it in */}
      <div class="absolute -left-[9999px] size-px overflow-hidden" aria-hidden="true">
        <label>
          Strona www <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <label class="group/consent mt-8 flex cursor-pointer items-start gap-4">
        <input type="checkbox" name="consent" class="sr-only" />
        <span class="mt-0.5 grid size-6 shrink-0 place-items-center border border-paper/60 text-ink transition-colors duration-300 group-has-checked/consent:border-accent group-has-checked/consent:bg-accent group-has-focus-visible/consent:outline-2 group-has-focus-visible/consent:outline-offset-2 group-has-focus-visible/consent:outline-accent">
          <svg
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
            class="size-3.5 opacity-0 transition-opacity duration-300 group-has-checked/consent:opacity-100"
          >
            <path
              d="M3 8.5l3.2 3L13 4.8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"
            />
          </svg>
        </span>
        <span class="font-body text-[0.875rem] leading-[1.4rem] font-medium text-paper/75">
          Zgadzam się na otrzymywanie newslettera od Michała Caby. Mogę się wypisać w każdej chwili.
          Szczegóły w{' '}
          <a
            href={site.privacyUrl}
            {...(privacyExternal ? { target: '_blank', rel: 'noopener' } : {})}
            class="underline underline-offset-2 transition-colors hover:text-accent"
          >
            polityce prywatności
          </a>
          .
        </span>
      </label>

      <p
        data-signup-error
        role="alert"
        class="mt-4 min-h-6 font-body text-body-sm font-medium text-accent"
      ></p>

      <Button type="submit" surface="dark" data-signup-submit class="mt-2">
        <span data-signup-submit-label>Wyślij mi plan</span>
      </Button>
    </form>
  </div>

  <div data-signup-done hidden tabindex="-1" class="outline-none">
    <p class:list={[label, 'text-accent']}>Zapisane</p>
    <h3 class="mt-4 font-display text-h3-sm font-bold lg:text-h3">
      Dziękuję<span data-signup-name></span>!
    </h3>
    <p class="mt-4 max-w-[33rem] font-body text-body-sm font-medium text-paper/80 lg:text-body">
      Plan jest w drodze. Sprawdź skrzynkę i potwierdź zapis.
    </p>
  </div>
</div>
