---
/**
 * The mirror: an oval silver frame whose reflection clears as the score grows.
 * `--fog` (1 → 0) drives the blur and the paper mist; scripts/lustro/mirror.ts tweens it with GSAP.
 * Reflection recoloured to the brand palette: paper sky warming into accent, an accent sun,
 * silver / muted hills and an ink silhouette (same monochrome + red grading as the photography).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  data-mirror
  class:list={['relative aspect-[200/270] w-full rounded-[50%] p-[4.5%]', className]}
  style="--fog: 1; background: linear-gradient(145deg, var(--color-white), var(--color-silver) 48%, var(--color-muted) 72%, var(--color-silver)); box-shadow: 0 2rem 4rem -2rem rgb(0 0 0 / 0.6)"
>
  <div class="relative size-full overflow-hidden rounded-[50%] bg-paper">
    <div class="absolute inset-0 scale-[1.06]" style="filter: blur(calc(var(--fog) * 0.875rem))">
      <svg
        viewBox="0 0 200 270"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        class="block size-full"
      >
        <defs>
          <linearGradient id="lustro-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" style="stop-color: var(--color-paper)"></stop>
            <stop
              offset=".6"
              style="stop-color: color-mix(in srgb, var(--color-accent) 22%, var(--color-paper))"
            ></stop>
            <stop
              offset="1"
              style="stop-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-paper))"
            ></stop>
          </linearGradient>
          <radialGradient id="lustro-glow" cx=".72" cy=".2" r=".5">
            <stop offset="0" style="stop-color: var(--color-accent); stop-opacity: .35"></stop>
            <stop offset="1" style="stop-color: var(--color-accent); stop-opacity: 0"></stop>
          </radialGradient>
        </defs>
        <rect width="200" height="270" fill="url(#lustro-sky)"></rect>
        <rect width="200" height="270" fill="url(#lustro-glow)"></rect>
        <circle cx="148" cy="58" r="20" class="fill-accent"></circle>
        <path
          d="M0 200 C40 180 70 190 100 182 C140 172 170 186 200 178 L200 270 L0 270Z"
          class="fill-silver"
        ></path>
        <path
          d="M0 225 C50 210 90 222 130 212 C160 205 185 214 200 210 L200 270 L0 270Z"
          class="fill-muted"
        ></path>
        <circle cx="100" cy="118" r="30" class="fill-ink"></circle>
        <path d="M38 270 C38 196 68 162 100 162 C132 162 162 196 162 270Z" class="fill-ink"></path>
      </svg>
    </div>
    {/* Mist: paper-coloured, thins out as --fog drops */}
    <div
      class="pointer-events-none absolute inset-0"
      style="opacity: calc(var(--fog) * 0.92); background: radial-gradient(ellipse at 40% 35%, rgb(241 238 232 / 0.55), rgb(241 238 232 / 0.96) 70%)"
    ></div>
    <div
      class="pointer-events-none absolute inset-0 opacity-60"
      style="background: linear-gradient(120deg, transparent 30%, rgb(255 255 255 / 0.35) 42%, transparent 50%)"
    ></div>
  </div>
</div>
