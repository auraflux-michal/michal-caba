---
/**
 * Step navigation, always in reach: sticky to the bottom of the quiz panel on every breakpoint
 * (mobile also shows the live mirror score). Stops at the panel end, never covers the footer.
 */
import Button from '@/components/ui/Button.astro';
---

<div
  data-lustro-nav
  hidden
  class="sticky bottom-0 z-30 -mx-5 mt-10 border-t border-ink bg-paper lg:-mx-inset"
>
  <div class="gutter-x flex items-center gap-3 py-3 lg:px-inset lg:py-5">
    <Button variant="ghost" back data-lustro-back aria-label="Wstecz" class="px-4 lg:px-6">
      <span class="hidden sm:inline">Wstecz</span>
    </Button>
    <p
      class="min-w-0 flex-1 text-center font-display text-label-sm uppercase lg:text-label"
      aria-live="polite"
    >
      <span class="block font-bold">
        <span data-nav-count>0 z 0</span>
        <span class="hidden sm:inline"> zaznaczone</span>
      </span>
      <span class="block text-muted lg:hidden">
        Lustro: <span data-mirror-percent>0</span>%
      </span>
    </p>
    <Button data-lustro-next>
      <span data-nav-next-label>Dalej</span>
    </Button>
  </div>
</div>
