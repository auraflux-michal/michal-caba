---
/** Thin quiz progress rule: 1px ink track, 2px accent fill (scaled by scripts/lustro). */
interface Props {
  /** 0–1 */
  value: number;
}

const { value } = Astro.props;
---

<div class="relative h-0.5" aria-hidden="true">
  <span class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-ink/20"></span>
  <span
    data-lustro-progress
    data-value={value}
    class="absolute inset-0 origin-left bg-accent"
    style={`transform: scaleX(${value})`}
  ></span>
</div>
