---
/**
 * Hero: Figma 899:516 (0-800px).
 * Desktop: section height = min(800px, viewport) so the whole hero (incl. bottom rail) fits
 * laptop screens. The headline/rule/quote keep their exact Figma offsets *relative to each other*
 * and the group is placed at the same proportional depth as in Figma (exactly 311px @ 800px).
 * The 3rd line rotates through `heroPhrases` (src/data/content.ts).
 */
import ArrowDown from '@/assets/icons/arrow-down.svg';
import { heroPhrases } from '@/data/content';
---

<section
  id="start"
  aria-labelledby="hero-title"
  class="relative flex min-h-svh flex-col bg-ink pt-header lg:block lg:h-[min(50rem,100svh)] lg:min-h-[36rem] lg:pt-0"
>
  {/*
    Composition group (lg): 264px tall (= H1). Top = header + free space × 0.6126,
    where 0.6126 = 234 / 382 reproduces Figma's y=311 inside an 800px hero.
  */}
  <div class="gutter-x flex flex-1 flex-col justify-center gap-10 py-16 lg:absolute lg:inset-x-0 lg:top-[calc(var(--spacing-header)+(100%-2*var(--spacing-header)-16.5rem)*0.6126)] lg:block lg:h-[16.5rem] lg:p-0">
    <h1
      id="hero-title"
      data-hero-title
      data-reveal="custom"
      class="font-display text-h1-sm font-bold text-paper uppercase lg:absolute lg:top-0 lg:left-inset lg:text-h1"
    >
      {/* Each line sits in a mask (padding-bottom keeps the Ę ogonek inside the clip) */}
      <span class="block overflow-hidden pb-[0.15em] -mb-[0.15em]">
        <span class="block" data-hero-line>
          Widzę
        </span>
      </span>
      <span class="block overflow-hidden pb-[0.15em] -mb-[0.15em]">
        <span class="block text-accent" data-hero-line>
          Potencjał
        </span>
      </span>
      <span class="block overflow-hidden pb-[0.15em] -mb-[0.15em]">
        {/* Rotating phrase: all phrases share one grid cell (baseline-aligned, width = widest) */}
        <span class="grid whitespace-nowrap" data-hero-line>
          {heroPhrases.map((phrase, index) => (
            <span data-hero-word class:list={['col-start-1 row-start-1', index > 0 && 'invisible']}>
              {phrase}
            </span>
          ))}
        </span>
      </span>
    </h1>

    {/* Connector rule: accent → paper gradient, 387×2 @ (564, 471) → +160px below the H1 top */}
    <span
      aria-hidden="true"
      data-hero-rule
      data-reveal="custom"
      class="hidden h-0.5 origin-left bg-linear-to-r from-accent to-paper lg:absolute lg:top-[10rem] lg:left-[35.25rem] lg:block lg:w-[24.1875rem]"
    >
      {/* "Current": a glowing pulse that travels the rule from Potencjał to the quote */}
      <span
        data-hero-spark
        class="pointer-events-none absolute top-1/2 left-0 h-6 w-28 -translate-y-1/2 opacity-0 mix-blend-screen"
      >
        <span class="absolute inset-x-0 top-1/2 h-4 -translate-y-1/2 rounded-full bg-linear-to-r from-transparent via-accent to-transparent blur-md"></span>
        <span class="absolute inset-x-4 top-1/2 h-1 -translate-y-1/2 rounded-full bg-linear-to-r from-transparent via-paper/90 to-transparent blur-[2px]"></span>
        <span class="absolute inset-x-8 top-1/2 h-0.5 -translate-y-1/2 bg-linear-to-r from-transparent via-white to-transparent"></span>
      </span>
    </span>

    <p
      data-hero-quote
      data-reveal="custom"
      class="max-w-[18rem] font-body text-lead-sm font-medium text-paper lg:absolute lg:top-[8.4375rem] lg:left-[59.1875rem] lg:max-w-none lg:text-lead lg:whitespace-nowrap"
    >
      {/* Desktop line breaks via lg:block spans (hidden <br>s confuse SplitText on mobile) */}
      <span class="lg:block">Lubię sprawdzać co się</span>
      <span class="lg:block">stanie kiedy przesuniemy</span>
      <span class="lg:block">
        go o{' '}
        <span class="text-accent" data-hero-tag>
          #1metrDalej
        </span>
      </span>
    </p>
  </div>

  {/* Bottom rail (Figma 899:538): right half is the top of the "Człowiek" paper panel */}
  <div class="grid h-header grid-cols-[minmax(0,1fr)_auto] border-t border-line lg:absolute lg:inset-x-0 lg:bottom-0 lg:grid-cols-2">
    <p
      data-hero-meta
      data-reveal="custom"
      class="gutter-x hidden min-w-0 items-center font-display text-label-sm whitespace-pre text-muted uppercase sm:flex lg:text-label"
    >
      {'Founder\u00A0\u00A0/\u00A0\u00A0Strateg\u00A0\u00A0/\u00A0\u00A0Projektant'}
    </p>
    {/* Mobile: the CTA alone (both labels side by side need ~390px and would force h-scroll) */}
    <div class="gutter-x col-span-2 flex items-center justify-end border-ink sm:col-span-1 lg:border-t lg:border-l lg:bg-paper">
      <a
        href="#czlowiek"
        data-hero-meta
        data-reveal="custom"
        class="group inline-flex items-center gap-2 font-display text-label-sm whitespace-nowrap text-muted uppercase lg:text-label"
      >
        Wyrusz w podróż
        <ArrowDown
          aria-hidden="true"
          width={24}
          height={24}
          class="size-6 -scale-y-100 transition-transform duration-500 ease-out-expo group-hover:translate-y-1"
        />
      </a>
    </div>
  </div>
</section>
