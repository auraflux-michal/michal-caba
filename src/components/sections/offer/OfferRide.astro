---
/**
 * Offer, direction E+ "Metr dalej" (C's language + E's movement).
 * Desktop: the section pins for a short ride (~1 screen of scroll) and vertical scroll moves
 * ONE route to the left: three stops light up as the accent line reaches them, then the accent
 * product slab arrives. A ruler at the bottom counts 0 → 100 cm: literally one metre further.
 * Everything stays readable at every moment (header fixed, only the route travels).
 * Mobile / reduced motion: no pin, the same route stacked vertically, all stops lit.
 */
import { offer } from '@/data/content';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import OfferCta from './OfferCta.astro';

const label = 'font-display text-label-sm uppercase lg:text-label';
const ticks = Array.from({ length: 11 }, (_, i) => i * 10);
---

<section
  aria-labelledby="offer-ride-title"
  data-ride
  class="ride relative overflow-hidden bg-ink text-paper"
>
  <div class="flex flex-col lg:h-svh">
    <div class="gutter-x flex h-label shrink-0 items-center">
      <SectionLabel tone="paper">Warsztat</SectionLabel>
    </div>

    {/* Header: stays put while the route travels */}
    <div class="gutter-x grid shrink-0 gap-6 pt-8 lg:grid-cols-[1fr_30rem] lg:items-end lg:gap-16 lg:px-inset lg:pt-4">
      <div>
        <p class:list={[label, 'text-paper/60']}>{offer.eyebrow}</p>
        <h2
          id="offer-ride-title"
          class="mt-5 font-display text-h2-sm font-bold uppercase lg:text-[4rem] lg:leading-[0.95]"
        >
          <span class="block">
            {offer.headline[0]} {offer.headline[1]}
          </span>
          <span class="block text-accent">{offer.headlineAccent}</span>
        </h2>
      </div>
      <div class="space-y-3">
        <p class="font-body text-body-sm font-semibold">{offer.lead}</p>
        <p class="font-body text-[0.9375rem] leading-6 font-medium text-paper/60">{offer.body}</p>
      </div>
    </div>

    {/* Route */}
    <div class="relative mt-12 min-h-0 lg:mt-10 lg:flex-1">
      <div
        data-ride-track
        class="ride-track relative flex flex-col gap-10 pr-5 pb-16 pl-14 will-change-transform lg:absolute lg:top-1/2 lg:left-0 lg:w-max lg:-translate-y-1/2 lg:flex-row lg:gap-0 lg:px-inset lg:pb-0"
      >
        {/* The line + its accent fill */}
        <span
          aria-hidden="true"
          class="absolute top-0 bottom-16 left-[1.6875rem] w-px bg-paper/25 lg:top-[0.4375rem] lg:right-inset lg:bottom-auto lg:left-inset lg:h-px lg:w-auto"
        >
          <span
            data-ride-fill
            class="ride-fill absolute inset-0 origin-top bg-accent lg:origin-left"
          ></span>
        </span>

        {offer.outcomes.map((item, index) => (
          <div
            data-ride-stop
            class:list={[
              'ride-stop relative lg:w-[27rem] lg:shrink-0 lg:pt-12 lg:pr-14',
              index === 0 && 'is-on',
            ]}
          >
            <span
              aria-hidden="true"
              class="ride-node absolute top-1 -left-[2.25rem] size-3.5 border border-paper bg-ink lg:top-0 lg:left-0"
            />
            <p class:list={[label, 'text-accent']}>Etap {item.number}</p>
            <h3 class="ride-title mt-2 font-display text-h3-sm font-bold lg:mt-3 lg:text-h3">
              {item.title}
            </h3>
            <p class="mt-2 max-w-[22rem] font-body text-body-sm font-medium text-paper/65">
              {item.text}
            </p>
          </div>
        ))}

        <div data-ride-stop class="ride-stop relative lg:w-[16rem] lg:shrink-0 lg:pt-12">
          <span
            aria-hidden="true"
            class="ride-node absolute top-1 -left-[2.25rem] size-3.5 border border-paper bg-ink lg:top-0 lg:left-0"
          />
          <p class:list={[label, 'text-paper/60']}>
            {offer.closing[0]}
            <br />
            {offer.closing[1]} →
          </p>
        </div>

        {/* Destination: the offer */}
        <div
          data-ride-stop
          class="ride-stop relative -ml-9 flex flex-col justify-between gap-8 bg-accent p-6 text-ink lg:ml-0 lg:w-[44rem] lg:shrink-0 lg:self-start lg:p-10"
        >
          <div>
            <p class={label}>{offer.format}</p>
            <p class="mt-3 font-display text-[3rem] leading-[0.9] font-bold uppercase lg:text-[4.5rem]">
              Mapa Kierunku<sup class="text-[0.3em]">™</sup>
            </p>
            <p class:list={[label, 'mt-3']}>{offer.tagline}</p>
          </div>
          <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <p class="flex items-baseline gap-2 font-display leading-none font-bold">
              <span class="text-[3.5rem] lg:text-[4.5rem]">{offer.price}</span>
              <span class="text-label-sm lg:text-label">{offer.currency}</span>
            </p>
            <OfferCta surface="accent" />
          </div>
        </div>
      </div>
    </div>

    {/* Ruler: 0 → 100 cm (desktop ride only) */}
    <div
      aria-hidden="true"
      class="ride-ruler relative hidden h-[4.5rem] shrink-0 border-t border-line lg:block"
    >
      <div class="absolute inset-x-inset top-0 h-full">
        <span class="ride-ticks absolute inset-x-0 top-0 h-2.5"></span>
        {ticks.map((cm) => (
          <span class="absolute top-0 h-4 w-px bg-paper/50" style={`left: ${cm}%`}>
            <span class="absolute top-5 -translate-x-1/2 font-display text-[0.75rem] whitespace-nowrap text-paper/45">
              {cm === 100 ? '1\u00A0m' : cm}
            </span>
          </span>
        ))}
        <span data-ride-marker class="absolute top-0 left-0 h-full">
          <span class="absolute top-0 -left-px h-10 w-0.5 bg-accent"></span>
          <span class="absolute top-[2.75rem] -translate-x-1/2 font-display text-[0.8125rem] font-bold whitespace-nowrap text-accent uppercase">
            <span data-ride-cm>0</span> cm
          </span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Minor ruler ticks every 2% (2 cm) */
  .ride-ticks {
    background: repeating-linear-gradient(
      to right,
      rgb(241 238 232 / 0.25) 0 1px,
      transparent 1px 2%
    );
  }

  /* Static (mobile / reduced motion): whole route lit */
  .ride-fill {
    transform: scale(1);
  }

  .ride-node {
    transition:
      background-color 0.4s,
      border-color 0.4s,
      transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .ride-title {
    transition: color 0.4s;
  }

  /* Ride mode (set by the script on desktop): stops wait to be reached */
  .ride.is-riding .ride-stop:not(.is-on) .ride-title {
    color: rgb(241 238 232 / 0.45);
  }

  .ride .ride-stop.is-on .ride-node,
  .ride:not(.is-riding) .ride-node {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
  }

  .ride.is-riding .ride-stop.is-on .ride-node {
    transform: scale(1.3);
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '@/scripts/lib/gsap';

  async function initRide(section: HTMLElement) {
    const track = section.querySelector<HTMLElement>('[data-ride-track]');
    const fill = section.querySelector<HTMLElement>('[data-ride-fill]');
    const marker = section.querySelector<HTMLElement>('[data-ride-marker]');
    const cm = section.querySelector<HTMLElement>('[data-ride-cm]');
    const stops = [...section.querySelectorAll<HTMLElement>('[data-ride-stop]')];
    if (!track || !fill || prefersReducedMotion()) return;

    await document.fonts.ready;

    gsap.matchMedia().add('(min-width: 64rem)', () => {
      const viewport = track.parentElement!;
      const distance = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
      section.classList.add('is-riding');

      const update = (progress: number) => {
        // A stop lights up when it slides past a "reading line" that itself moves right as the
        // ride goes on (26% → 50% of the route width): stops light one by one, the slab last.
        const width = viewport.clientWidth;
        const line = width * (0.26 + 0.24 * progress);
        const shift = progress * distance();
        stops.forEach((stop, index) =>
          stop.classList.toggle('is-on', index === 0 || stop.offsetLeft - shift <= line),
        );
        if (marker) marker.style.left = `${progress * 100}%`;
        if (cm) cm.textContent = String(Math.round(progress * 100));
      };

      gsap.set(fill, { scaleX: 0 });
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${distance() * 1.15}`,
          pin: true,
          scrub: 0.6,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => update(self.progress),
          onRefresh: (self) => update(self.progress),
        },
      });
      tl.to(track, { x: () => -distance() }, 0).to(fill, { scaleX: 1 }, 0);

      return () => {
        section.classList.remove('is-riding');
        stops.forEach((stop, index) => stop.classList.toggle('is-on', index === 0));
      };
    });

    ScrollTrigger.refresh();
  }

  document.querySelectorAll<HTMLElement>('[data-ride]').forEach((section) => {
    initRide(section);
  });
</script>
