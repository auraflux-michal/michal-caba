---
/**
 * Offer, direction C+ "Trasa" (refined C): ~25% shorter. Headline in two lines across the full
 * width, lead + body side by side, then the route: when it scrolls into view the accent line
 * draws left → right and the three stops light up in turn (the hero's "current" keeps running
 * afterwards). Ends in a compact accent slab: name | price | CTA in one row.
 */
import { offer } from '@/data/content';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import SplitLines from '@/components/ui/SplitLines.astro';
import OfferCta from './OfferCta.astro';

const label = 'font-display text-label-sm uppercase lg:text-label';
---

<section
  aria-labelledby="offer-cplus-title"
  data-route-plus
  class="route-plus relative overflow-hidden bg-ink text-paper"
>
  <div class="gutter-x flex h-label items-center">
    <SectionLabel tone="paper">Warsztat</SectionLabel>
  </div>

  <div class="gutter-x pt-10 lg:px-inset lg:pt-12">
    <p class:list={[label, 'text-paper/60']}>{offer.eyebrow}</p>
    <h2
      id="offer-cplus-title"
      class="mt-6 font-display text-h2-sm font-bold uppercase lg:text-[4.5rem] lg:leading-[0.95]"
    >
      <SplitLines as="span" class="block">
        {`${offer.headline[0]} ${offer.headline[1]}`}
      </SplitLines>
      <SplitLines as="span" class="block text-accent" delay={0.15}>
        {offer.headlineAccent}
      </SplitLines>
    </h2>
    <div class="mt-8 grid gap-4 lg:mt-10 lg:grid-cols-2 lg:gap-20">
      <SplitLines class="font-body text-body-sm font-semibold lg:text-body" delay={0.2}>
        {offer.lead}
      </SplitLines>
      <SplitLines class="font-body text-body-sm font-medium text-paper/60" delay={0.3}>
        {offer.body}
      </SplitLines>
    </div>
  </div>

  {/* Route */}
  <div class="gutter-x mt-14 lg:mt-20 lg:px-inset">
    <p class:list={[label, 'text-paper/60']}>{offer.outcomesLabel}</p>
    <ol class="relative mt-8 grid gap-10 pl-10 lg:grid-cols-3 lg:gap-10 lg:pt-12 lg:pl-0">
      <span
        aria-hidden="true"
        class="absolute top-0 bottom-0 left-[0.4375rem] w-px bg-paper/25 lg:top-[0.4375rem] lg:right-0 lg:bottom-auto lg:left-0 lg:h-px lg:w-auto"
      >
        <span class="rp-fill absolute inset-0 origin-top bg-accent lg:origin-left"></span>
        <span class="rp-spark absolute"></span>
      </span>
      {offer.outcomes.map((item, index) => (
        <li class="rp-stop relative" style={`--i: ${index}`}>
          <span
            aria-hidden="true"
            class="rp-node absolute top-1 -left-10 size-3.5 border border-paper bg-ink lg:-top-12 lg:left-0"
          />
          <p class:list={[label, 'text-accent']}>Etap {item.number}</p>
          <h3 class="mt-2 font-display text-h3-sm font-bold lg:mt-3 lg:text-h3">{item.title}</h3>
          <p class="mt-2 max-w-[24rem] font-body text-body-sm font-medium text-paper/65">
            {item.text}
          </p>
        </li>
      ))}
    </ol>
  </div>

  {/* Compact product slab */}
  <div class="mx-5 mt-14 mb-16 grid gap-6 bg-accent p-6 text-ink lg:mx-inset lg:mt-20 lg:mb-20 lg:grid-cols-[1fr_auto_auto] lg:items-end lg:gap-12 lg:px-10 lg:py-9">
    <div>
      <p class={label}>
        {offer.closing[0]} {offer.closing[1]}
      </p>
      <p class="mt-3 font-display text-[2.75rem] leading-[0.9] font-bold uppercase lg:text-[4.5rem]">
        Mapa Kierunku<sup class="text-[0.3em]">™</sup>
      </p>
      <p class:list={[label, 'mt-2']}>{offer.format}</p>
    </div>
    <p class="flex items-baseline gap-2 font-display leading-none font-bold">
      <span class="text-[3.5rem] lg:text-[4.5rem]">{offer.price}</span>
      <span class="text-label-sm lg:text-label">{offer.currency}</span>
    </p>
    <OfferCta surface="accent" />
  </div>
</section>

<style>
  /* Line draws, stops light up in turn once the route is in view (.is-lit, script below) */
  .rp-fill {
    transform: scale(0);
    transition: transform 1.8s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .rp-node {
    transition:
      background-color 0.4s calc(0.3s + var(--i) * 0.55s),
      border-color 0.4s calc(0.3s + var(--i) * 0.55s),
      transform 0.6s cubic-bezier(0.19, 1, 0.22, 1) calc(0.3s + var(--i) * 0.55s);
  }

  .rp-stop {
    opacity: 0.45;
    transition: opacity 0.6s calc(0.3s + var(--i) * 0.55s);
  }

  .is-lit .rp-fill {
    transform: scale(1);
  }

  .is-lit .rp-stop {
    opacity: 1;
  }

  .is-lit .rp-node {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    transform: scale(1.3);
  }

  /* The hero's "current" keeps running once the route is lit */
  .rp-spark {
    display: none;
    inset: -0.5rem auto auto -0.75rem;
    width: 1.5rem;
    height: 4rem;
    background: radial-gradient(closest-side, var(--color-paper), transparent);
    filter: blur(2px);
    animation: rp-y 4.5s cubic-bezier(0.76, 0, 0.24, 1) 2.2s infinite;
  }

  .is-lit .rp-spark {
    display: block;
  }

  @media (min-width: 64rem) {
    .rp-spark {
      inset: -0.75rem auto auto 0;
      width: 7rem;
      height: 1.5rem;
      animation-name: rp-x;
    }
  }

  @keyframes rp-x {
    from {
      left: -7rem;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    to {
      left: 100%;
      opacity: 0;
    }
  }

  @keyframes rp-y {
    from {
      top: -4rem;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    to {
      top: 100%;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rp-fill,
    .rp-node,
    .rp-stop {
      transition: none;
    }

    .rp-spark {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-route-plus]').forEach((section) => {
    const route = section.querySelector('ol');
    if (!route) return;
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        section.classList.add('is-lit');
        observer.disconnect();
      },
      { threshold: 0.6 },
    );
    observer.observe(route);
  });
</script>
