---
/**
 * Booking CTA for the offer variants: live link when `offer.bookingUrl` is set, otherwise a
 * disabled box + "Rezerwacja wkrótce". `surface` = what it sits on.
 */
import { offer } from '@/data/content';
import ArrowUpRight from '@/assets/icons/arrow-up-right.svg';

interface Props {
  surface?: 'ink' | 'paper' | 'accent';
  class?: string;
}

const { surface = 'ink', class: className } = Astro.props;
const live = {
  ink: 'border-accent bg-accent text-ink hover:border-paper hover:bg-paper',
  paper: 'border-ink bg-accent text-ink hover:bg-ink hover:text-paper',
  accent: 'border-ink bg-ink text-paper hover:bg-paper hover:text-ink',
}[surface];
const off = {
  ink: 'border-accent/30 bg-accent/25 text-paper/60',
  paper: 'border-ink/20 bg-ink/5 text-ink/45',
  accent: 'border-ink/30 bg-ink/15 text-ink/55',
}[surface];
const box =
  'inline-flex min-h-14 items-center justify-center gap-3 border px-8 font-display text-label-sm font-bold whitespace-nowrap uppercase lg:min-h-16 lg:px-10 lg:text-label';
---

<div class:list={['flex flex-col items-start gap-2', className]}>
  {offer.bookingUrl ? (
    <a
      href={offer.bookingUrl}
      target="_blank"
      rel="noopener"
      class:list={[box, live, 'group transition-colors duration-300']}
    >
      {offer.cta}
      <span class="sr-only"> (otwiera się w nowej karcie)</span>
      <ArrowUpRight
        aria-hidden="true"
        width={24}
        height={24}
        class="size-5 transition-transform duration-500 ease-out-expo group-hover:translate-x-1 group-hover:-translate-y-1"
      />
    </a>
  ) : (
    <span role="link" aria-disabled="true" class:list={[box, off, 'cursor-not-allowed']}>
      {offer.cta} <span aria-hidden="true">↗</span>
    </span>
  )}
  {!offer.bookingUrl && (
    <p
      class:list={[
        'font-body text-[0.875rem] font-medium',
        surface === 'ink' ? 'text-paper/55' : 'text-ink/60',
      ]}
    >
      {offer.bookingNote}
    </p>
  )}
</div>
