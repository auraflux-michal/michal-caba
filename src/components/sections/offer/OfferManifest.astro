---
/**
 * Offer, direction A "Manifest": the question is the hero (display-size, like #1METR DALEJ),
 * outcomes as three columns split by 1px rules with big `_0n` numerals (Roles language),
 * and a paper price band that lands like the Build card: product, price, CTA in one line.
 */
import { offer } from '@/data/content';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import SplitLines from '@/components/ui/SplitLines.astro';
import OfferCta from './OfferCta.astro';

const label = 'font-display text-label-sm uppercase lg:text-label';
---

<section aria-labelledby="offer-a-title" class="relative bg-ink text-paper">
  <div class="gutter-x flex h-label items-center">
    <SectionLabel tone="paper">Warsztat</SectionLabel>
  </div>

  <div class="gutter-x pt-12 lg:px-inset lg:pt-20">
    <p class:list={[label, 'text-accent']}>{offer.eyebrow}</p>
    <h2
      id="offer-a-title"
      class="mt-6 font-display text-[3rem] leading-[0.92] font-bold uppercase sm:text-[4.5rem] lg:mt-8 lg:text-[7.5rem]"
    >
      <SplitLines as="span" class="block">
        {offer.headline[0]}
        <br />
        {offer.headline[1]}
      </SplitLines>
      <SplitLines as="span" class="block text-accent" delay={0.15}>
        {offer.headlineAccent}
      </SplitLines>
    </h2>

    <div class="mt-12 grid gap-6 lg:mt-20 lg:grid-cols-[1fr_41.25rem]">
      <p class:list={[label, 'text-paper/60']}>
        Mapa Kierunku™
        <br />
        {offer.format}
      </p>
      <div class="space-y-5">
        <SplitLines class="font-body text-body-sm font-semibold lg:text-body" delay={0.1}>
          {offer.lead}
        </SplitLines>
        <SplitLines class="font-body text-body-sm font-medium text-paper/60" delay={0.2}>
          {offer.body}
        </SplitLines>
      </div>
    </div>
  </div>

  <ol class="mt-16 grid border-t border-line lg:mt-24 lg:grid-cols-3">
    {offer.outcomes.map((item, index) => (
      <li
        data-reveal
        data-fade
        data-delay={index * 0.1}
        class="gutter-x border-b border-line py-10 lg:border-b-0 lg:px-10 lg:py-14 lg:not-first:border-l lg:first:pl-inset"
      >
        <p class="flex font-display text-[4rem] leading-none font-bold lg:text-[5.5rem]">
          <span class="text-accent">_</span>
          {item.number}
        </p>
        <h3 class="mt-8 font-display text-h4-sm font-bold lg:mt-10 lg:text-h4">{item.title}</h3>
        <p class="mt-3 max-w-[22rem] font-body text-body-sm font-medium text-paper/65">
          {item.text}
        </p>
      </li>
    ))}
  </ol>

  {/* Price band */}
  <div
    data-reveal
    data-wipe
    class="gutter-x grid items-center gap-8 bg-paper py-10 text-ink lg:grid-cols-[1fr_auto_auto] lg:gap-16 lg:px-inset lg:py-12"
  >
    <div>
      <p class="font-display text-h3-sm font-bold uppercase lg:text-h3">
        Mapa Kierunku<sup class="text-[0.4em]">™</sup>
      </p>
      <p class:list={[label, 'mt-1 text-ink/60']}>{offer.tagline}</p>
    </div>
    <p class="flex items-baseline gap-2 font-display leading-none font-bold">
      <span class="text-[4rem] lg:text-[5.5rem]">{offer.price}</span>
      <span class="text-label-sm lg:text-label">{offer.currency}</span>
    </p>
    <OfferCta surface="paper" />
  </div>
</section>
