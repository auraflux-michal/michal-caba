---
/**
 * Offer, direction E "Przejazd": the only horizontal moment on the page. On desktop the
 * section pins and vertical scroll drives a horizontal track: pitch → three stages (huge `_0n`
 * numerals) → accent product panel with price + CTA. A day counter + accent rail at the bottom
 * shows how far along the 30-day route you are. Mobile / reduced motion: plain vertical stack.
 */
import { offer } from '@/data/content';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import OfferCta from './OfferCta.astro';

const label = 'font-display text-label-sm uppercase lg:text-label';
const panel =
  'relative flex shrink-0 flex-col border-b border-line lg:h-full lg:border-r lg:border-b-0';
---

<section
  aria-labelledby="offer-e-title"
  data-offer-track
  class="relative overflow-hidden bg-ink text-paper lg:h-svh"
>
  <div class="gutter-x flex h-label items-center lg:absolute lg:inset-x-0 lg:top-0 lg:z-10">
    <SectionLabel tone="paper">Warsztat</SectionLabel>
  </div>

  <div data-track class="flex flex-col will-change-transform lg:h-full lg:w-max lg:flex-row">
    {/* 1. Pitch */}
    <div class:list={[panel, 'gutter-x justify-center py-12 lg:w-[52rem] lg:px-inset lg:py-0']}>
      <p class:list={[label, 'text-paper/60']}>{offer.eyebrow}</p>
      <h2 id="offer-e-title" class="mt-8 font-display text-h1-sm font-bold uppercase lg:text-h1">
        {offer.headline[0]}
        <br />
        {offer.headline[1]}
        <span class="block text-accent">{offer.headlineAccent}</span>
      </h2>
      <p class="mt-8 max-w-[34rem] font-body text-body-sm font-semibold lg:mt-10 lg:text-body">
        {offer.lead}
      </p>
      <p class="mt-4 max-w-[34rem] font-body text-body-sm font-medium text-paper/60">
        {offer.body}
      </p>
      <p class:list={[label, 'mt-12 hidden items-center gap-3 text-accent lg:flex']}>
        Przewiń, żeby przejść trasę{' '}
        <span aria-hidden="true" class="track-nudge">
          →
        </span>
      </p>
    </div>

    {/* 2–4. Stages */}
    {offer.outcomes.map((item, index) => (
      <div
        data-track-stage
        class:list={[panel, 'gutter-x justify-end py-12 lg:w-[34rem] lg:px-12 lg:pt-32 lg:pb-36']}
      >
        <p class:list={[label, 'text-paper/60']}>
          Etap {item.number} / {String(offer.outcomes.length).padStart(2, '0')}
        </p>
        <p class="mt-4 flex font-display text-[6rem] leading-[0.85] font-bold lg:mt-auto lg:text-[12rem]">
          <span class="text-accent">_</span>
          {item.number}
        </p>
        <h3 class="mt-8 font-display text-h2-sm font-bold lg:mt-10 lg:text-h2">{item.title}</h3>
        <p class="mt-4 max-w-[26rem] font-body text-body-sm font-medium text-paper/65 lg:text-body">
          {item.text}
        </p>
        {index === offer.outcomes.length - 1 && (
          <p class:list={[label, 'mt-8 text-accent']}>Dzień 30 →</p>
        )}
      </div>
    ))}

    {/* 5. Product */}
    <div
      class:list={[
        panel,
        'gutter-x justify-between bg-accent py-12 text-ink lg:w-[48rem] lg:px-inset lg:pt-32 lg:pb-36',
      ]}
    >
      <div>
        <p class={label}>{offer.format}</p>
        <p class="mt-6 font-display text-[3.5rem] leading-[0.88] font-bold uppercase lg:text-[7.5rem]">
          Mapa
          <br />
          Kierunku<sup class="text-[0.25em]">™</sup>
        </p>
        <p class:list={[label, 'mt-6']}>{offer.tagline}</p>
      </div>
      <div class="mt-12 flex flex-col gap-8 lg:mt-0 lg:flex-row lg:items-end lg:justify-between">
        <p class="flex items-baseline gap-2 font-display leading-none font-bold">
          <span class="text-[4rem] lg:text-[6rem]">{offer.price}</span>
          <span class="text-label-sm lg:text-label">{offer.currency}</span>
        </p>
        <OfferCta surface="accent" />
      </div>
    </div>
  </div>

  {/* Progress: day counter + rail (desktop, driven by the scroll) */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-16 items-center gap-6 border-t border-line bg-ink px-10 lg:flex"
  >
    <p class:list={[label, 'w-28 text-paper/60']}>
      Dzień{' '}
      <span data-track-day class="text-paper">
        1
      </span>
    </p>
    <span class="relative h-0.5 flex-1 bg-paper/15">
      <span
        data-track-bar
        class="absolute inset-0 origin-left bg-accent"
        style="transform: scaleX(0)"
      ></span>
    </span>
    <p class:list={[label, 'text-paper/60']}>30</p>
  </div>
</section>

<style>
  .track-nudge {
    animation: nudge 1.6s cubic-bezier(0.76, 0, 0.24, 1) infinite;
  }

  @keyframes nudge {
    50% {
      transform: translateX(0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track-nudge {
      animation: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '@/scripts/lib/gsap';

  document.querySelectorAll<HTMLElement>('[data-offer-track]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-track]');
    const bar = section.querySelector<HTMLElement>('[data-track-bar]');
    const day = section.querySelector<HTMLElement>('[data-track-day]');
    if (!track || prefersReducedMotion()) return;

    gsap.matchMedia().add('(min-width: 64rem)', () => {
      const distance = () => track.scrollWidth - section.clientWidth;
      gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          scrub: 0.8,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (bar) gsap.set(bar, { scaleX: self.progress });
            if (day) day.textContent = String(Math.max(1, Math.round(self.progress * 30)));
          },
        },
      });
      // Stage numerals drift against the track for depth
      section.querySelectorAll('[data-track-stage] p.flex').forEach((numeral) => {
        gsap.fromTo(
          numeral,
          { xPercent: 30 },
          {
            xPercent: -10,
            ease: 'none',
            scrollTrigger: {
              trigger: section,
              start: 'top top',
              end: () => `+=${distance()}`,
              scrub: true,
            },
          },
        );
      });
    });
    ScrollTrigger.refresh();
  });
</script>
