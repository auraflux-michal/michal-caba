---
/**
 * Offer, framed panel (Michał's draft, refined).
 * Frame: open on the right. The top and bottom accent rules run to the viewport edge, the left
 * rule closes it, there is no right rule. It draws itself in on scroll (GSAP).
 * Left: pain first (headline, what it feels like, three symptoms), then the way out.
 * Right (after an accent divider): format, price (counts up), the three steps as an accordion
 * (one open at a time, GSAP height), booking CTA (offer.bookingUrl).
 * No JS / reduced motion: everything static and visible, native <details> still toggle.
 */
import { offer } from '@/data/content';
import OfferCta from './OfferCta.astro';

const label = 'font-display text-label-sm uppercase lg:text-label';
const { pain } = offer;
const mask = 'block overflow-hidden pb-[0.12em] -mb-[0.12em]';
---

<section
  id="warsztat"
  data-panel
  data-reveal="custom"
  aria-labelledby="offer-panel-title"
  class="relative overflow-hidden bg-ink pt-16 pb-16 text-paper lg:pt-20 lg:pb-20"
>
  <div class="relative ml-5 lg:ml-gutter">
    {/* Frame: top + bottom to the right edge, left side, no right side */}
    <span
      aria-hidden="true"
      data-frame="top"
      class="absolute inset-x-0 top-0 h-px origin-left bg-accent"
    ></span>
    <span
      aria-hidden="true"
      data-frame="left"
      class="absolute inset-y-0 left-0 w-px origin-top bg-accent"
    ></span>
    <span
      aria-hidden="true"
      data-frame="bottom"
      class="absolute inset-x-0 bottom-0 h-px origin-left bg-accent"
    ></span>

    <div class="grid lg:grid-cols-[1fr_1px_minmax(0,31rem)] lg:gap-x-16 lg:py-14 lg:pr-[calc(var(--spacing-gutter)+4rem)] lg:pl-16">
      {/* Pain */}
      <div class="py-10 pr-5 pl-6 lg:p-0">
        <h2
          id="offer-panel-title"
          class="font-display text-h2-sm font-bold uppercase lg:text-[5rem] lg:leading-[0.92]"
        >
          <span class={mask}>
            <span class="block" data-panel-line>
              {pain.headline[0]}
            </span>
          </span>
          <span class={mask}>
            <span class="block" data-panel-line>
              {pain.headline[1]}
            </span>
          </span>
          <span class={mask}>
            <span class="block" data-panel-line>
              {pain.headlinePre}&nbsp;<span class="text-accent">{pain.headlineAccent}</span>
            </span>
          </span>
        </h2>
        <p
          data-panel-fade
          class="mt-8 max-w-[34rem] font-body text-body-sm font-semibold lg:mt-10 lg:text-body"
        >
          {pain.lead}
        </p>
        <ul class="mt-6 space-y-2">
          {pain.points.map((point) => (
            <li data-panel-fade class="flex gap-3 font-body text-body-sm font-medium text-paper/75">
              <span
                aria-hidden="true"
                data-panel-x
                class="inline-block font-display font-bold text-accent"
              >
                ×
              </span>
              {point}
            </li>
          ))}
        </ul>
        <p data-panel-fade class:list={[label, 'mt-8 max-w-[30rem] text-paper lg:mt-10']}>
          {pain.resolution}
        </p>
      </div>

      {/* Dividers: vertical (lg) / horizontal (mobile) */}
      <span
        aria-hidden="true"
        data-frame="divider"
        class="hidden origin-top bg-accent lg:block"
      ></span>
      <span
        aria-hidden="true"
        data-frame="divider-x"
        class="ml-6 h-px origin-left bg-accent lg:hidden"
      ></span>

      {/* Offer */}
      <div class="py-10 pr-5 pl-6 lg:p-0">
        <p data-panel-fade class:list={[label, 'text-paper/60']}>
          {offer.format}
        </p>
        <p class="mt-3 flex items-baseline gap-3 font-display leading-none font-bold">
          <span
            data-panel-price
            data-value={offer.price}
            class="text-[4rem] text-accent tabular-nums lg:text-[5.5rem]"
          >
            {offer.price}
          </span>
          <span data-panel-fade class="text-label-sm lg:text-label">
            {offer.currency}
          </span>
        </p>

        <div class="relative mt-8 lg:mt-10">
          <span
            aria-hidden="true"
            data-panel-rule
            class="absolute inset-x-0 top-0 h-px origin-left bg-line"
          ></span>
          {offer.outcomes.map((item, index) => (
            // Wrapper holds the rule: children of a closed <details> (other than <summary>) aren't rendered
            <div class="relative">
              <details name="mapa-kroki" class="step group" open={index === 0} data-panel-step>
                <summary class="flex cursor-pointer list-none items-baseline gap-4 py-4 lg:py-5 [&::-webkit-details-marker]:hidden">
                  <span class="step-num w-6 shrink-0 font-display text-[0.8125rem] text-paper/50 transition-colors">
                    {item.number}
                  </span>
                  <span class="flex-1 font-display text-[1.5rem] leading-tight font-bold uppercase transition-colors group-hover:text-accent lg:text-[1.75rem]">
                    {item.title}
                  </span>
                  <span
                    aria-hidden="true"
                    class="step-icon font-display text-[1.5rem] leading-none text-accent transition-[rotate] duration-500 ease-out-expo"
                  >
                    +
                  </span>
                </summary>
                <div data-step-body class="overflow-hidden">
                  <p class="pr-8 pb-5 pl-10 font-body text-body-sm font-medium text-paper/70">
                    {item.text}
                  </p>
                </div>
              </details>
              <span
                aria-hidden="true"
                data-panel-rule
                class="absolute inset-x-0 bottom-0 h-px origin-left bg-line"
              />
            </div>
          ))}
        </div>

        <div data-panel-fade class="mt-8 lg:mt-10">
          <OfferCta surface="ink" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Open state: native [open] before JS, .is-open once the script drives the accordion */
  .step:not(.js)[open] .step-icon,
  .step.is-open .step-icon {
    rotate: 45deg;
  }

  .step:not(.js)[open] .step-num,
  .step.is-open .step-num {
    color: var(--color-accent);
  }

  .step summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>

<script>
  import { gsap, motion, prefersReducedMotion, unveil } from '@/scripts/lib/gsap';

  /** One-open-at-a-time accordion with GSAP height (replaces the native `name` exclusivity) */
  function initAccordion(section: HTMLElement, reduced: boolean) {
    const steps = [...section.querySelectorAll<HTMLDetailsElement>('[data-panel-step]')];
    steps.forEach((step) => {
      step.removeAttribute('name');
      step.classList.add('js');
      step.classList.toggle('is-open', step.open);
    });

    const close = (step: HTMLDetailsElement) => {
      const body = step.querySelector<HTMLElement>('[data-step-body]')!;
      step.classList.remove('is-open');
      if (reduced) {
        step.open = false;
        return;
      }
      gsap.to(body, {
        height: 0,
        duration: 0.45,
        ease: 'power3.inOut',
        onComplete: () => {
          step.open = false;
          gsap.set(body, { clearProps: 'height' });
        },
      });
    };

    const open = (step: HTMLDetailsElement) => {
      const body = step.querySelector<HTMLElement>('[data-step-body]')!;
      step.open = true;
      step.classList.add('is-open');
      if (reduced) return;
      gsap.fromTo(
        body,
        { height: 0 },
        { height: 'auto', duration: 0.7, ease: motion.ease, clearProps: 'height' },
      );
      gsap.fromTo(
        body.firstElementChild,
        { autoAlpha: 0, y: 12 },
        { autoAlpha: 1, y: 0, duration: 0.6, delay: 0.1, clearProps: 'all' },
      );
    };

    steps.forEach((step) => {
      step.querySelector('summary')!.addEventListener('click', (event) => {
        event.preventDefault();
        if (step.classList.contains('is-open')) {
          close(step);
          return;
        }
        steps
          .filter((other) => other !== step && other.classList.contains('is-open'))
          .forEach(close);
        open(step);
      });
    });
  }

  function initEntrance(section: HTMLElement) {
    const q = (selector: string) => [...section.querySelectorAll<HTMLElement>(selector)];
    const frame = (side: string) => section.querySelector(`[data-frame="${side}"]`);
    const price = section.querySelector<HTMLElement>('[data-panel-price]');
    const target = Number(price?.dataset.value ?? 0);

    const tl = gsap.timeline({
      defaults: { ease: motion.ease, duration: motion.duration.reveal },
      scrollTrigger: { trigger: section, start: 'top 75%', once: true },
    });

    // 1. The pen: top rule runs to the edge, the left rule drops, the bottom rule follows
    tl.from(frame('top'), { scaleX: 0, duration: 1.4, ease: motion.easeInOut }, 0)
      .from(frame('left'), { scaleY: 0, duration: 1, ease: motion.easeInOut }, 0.15)
      .from(frame('bottom'), { scaleX: 0, duration: 1.4, ease: motion.easeInOut }, 0.7)
      .from(frame('divider'), { scaleY: 0, duration: 1.1, ease: motion.easeInOut }, 0.5)
      .from(frame('divider-x'), { scaleX: 0, duration: 1.1, ease: motion.easeInOut }, 0.5)
      // 2. Headline rises through its masks
      .from(
        q('[data-panel-line]'),
        { yPercent: 110, stagger: motion.stagger.loose, duration: 1.3 },
        0.25,
      )
      // 3. Copy, symptoms (× spins in), offer meta
      .from(q('[data-panel-fade]'), { autoAlpha: 0, y: 24, stagger: 0.07 }, 0.7)
      .from(q('[data-panel-x]'), { rotation: -180, scale: 0, stagger: 0.1, duration: 0.8 }, 0.9)
      // 4. Step rules draw, rows slide in
      .from(
        q('[data-panel-rule]'),
        { scaleX: 0, stagger: 0.12, duration: 1, ease: motion.easeInOut },
        0.8,
      )
      .from(q('[data-panel-step] summary'), { autoAlpha: 0, x: -20, stagger: 0.12 }, 0.9)
      .from(q('[data-panel-step][open] [data-step-body] > p'), { autoAlpha: 0, y: 12 }, 1.3);

    // 5. Price counts up to its value
    if (price && target) {
      const counter = { value: 0 };
      price.textContent = '0';
      tl.to(
        counter,
        {
          value: target,
          duration: 1.6,
          ease: 'power3.out',
          onUpdate: () => {
            price.textContent = String(Math.round(counter.value));
          },
        },
        0.6,
      );
    }
  }

  document.querySelectorAll<HTMLElement>('[data-panel]').forEach((section) => {
    const reduced = prefersReducedMotion();
    initAccordion(section, reduced);
    const animated = document.documentElement.classList.contains('is-animated');
    try {
      if (animated && !reduced) initEntrance(section);
    } finally {
      unveil(section); // never leave the module hidden, even if the entrance failed
    }
  });
</script>
