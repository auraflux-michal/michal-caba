---
/**
 * Offer, direction C "Trasa": the workshop as a route. Three stops on one line (Diagnoza →
 * Priorytety → Plan na 30 dni) with the hero's "current" travelling along it (#1metrDalej:
 * movement, one metre at a time). Ends in an accent slab: the product name huge, price, CTA.
 * Mobile: the route turns vertical.
 */
import { offer } from '@/data/content';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import SplitLines from '@/components/ui/SplitLines.astro';
import OfferCta from './OfferCta.astro';

const label = 'font-display text-label-sm uppercase lg:text-label';
---

<section aria-labelledby="offer-c-title" class="relative overflow-hidden bg-ink text-paper">
  <div class="gutter-x flex h-label items-center">
    <SectionLabel tone="paper">Warsztat</SectionLabel>
  </div>

  <div class="gutter-x grid gap-10 pt-12 lg:grid-cols-[1fr_35rem] lg:gap-20 lg:px-inset lg:pt-16">
    <div>
      <p class:list={[label, 'text-paper/60']}>{offer.eyebrow}</p>
      <h2 id="offer-c-title" class="mt-8 font-display text-h1-sm font-bold uppercase lg:text-h1">
        <SplitLines as="span" class="block">
          {offer.headline[0]}
          <br />
          {offer.headline[1]}
        </SplitLines>
        <SplitLines as="span" class="block text-accent" delay={0.15}>
          {offer.headlineAccent}
        </SplitLines>
      </h2>
    </div>
    <div class="space-y-5 lg:self-end">
      <SplitLines class="font-body text-body-sm font-semibold lg:text-body" delay={0.2}>
        {offer.lead}
      </SplitLines>
      <SplitLines class="font-body text-body-sm font-medium text-paper/60" delay={0.3}>
        {offer.body}
      </SplitLines>
    </div>
  </div>

  {/* Route */}
  <div class="gutter-x mt-16 lg:mt-28 lg:px-inset">
    <p class:list={[label, 'text-paper/60']}>{offer.outcomesLabel}</p>
    <ol class="route relative mt-10 grid gap-12 pl-10 lg:grid-cols-3 lg:gap-10 lg:pt-14 lg:pl-0">
      {/* The line + travelling current */}
      <span
        aria-hidden="true"
        class="route-line absolute top-0 bottom-0 left-[0.4375rem] w-px bg-paper/25 lg:top-[0.4375rem] lg:right-0 lg:bottom-auto lg:left-0 lg:h-px lg:w-auto"
      >
        <span class="route-spark absolute"></span>
      </span>
      {offer.outcomes.map((item) => (
        <li data-reveal data-fade class="relative">
          <span
            aria-hidden="true"
            class="absolute top-1 -left-10 size-3.5 border border-paper bg-ink lg:-top-14 lg:left-0"
          />
          <span class:list={[label, 'text-accent']}>Etap {item.number}</span>
          <h3 class="mt-3 font-display text-h3-sm font-bold lg:mt-4 lg:text-h3">{item.title}</h3>
          <p class="mt-3 max-w-[24rem] font-body text-body-sm font-medium text-paper/65">
            {item.text}
          </p>
        </li>
      ))}
    </ol>
    <p class:list={[label, 'mt-12 text-right text-paper/60 lg:mt-16']}>
      {offer.closing[0]} {offer.closing[1]} →
    </p>
  </div>

  {/* Product slab */}
  <div
    data-reveal
    data-wipe
    class="gutter-x mt-16 grid gap-8 bg-accent py-10 text-ink lg:mx-inset lg:mt-20 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-x-16 lg:px-10 lg:py-12"
  >
    <div>
      <p class={label}>{offer.format}</p>
      <p class="mt-3 font-display text-[3.25rem] leading-[0.9] font-bold uppercase lg:text-[6.5rem]">
        Mapa Kierunku<sup class="text-[0.3em]">™</sup>
      </p>
    </div>
    <div class="flex flex-col gap-6 lg:items-end">
      <p class="flex items-baseline gap-2 font-display leading-none font-bold">
        <span class="text-[3.5rem] lg:text-[4.5rem]">{offer.price}</span>
        <span class="text-label-sm lg:text-label">{offer.currency}</span>
      </p>
      <OfferCta surface="accent" class="lg:items-end" />
    </div>
  </div>
  <div class="h-20 lg:h-28" aria-hidden="true"></div>
</section>

<style>
  /* The hero's "current": a glowing pulse travelling the route, Diagnoza → Plan */
  .route-spark {
    inset: -0.5rem auto auto -0.75rem;
    width: 1.5rem;
    height: 4rem;
    background: radial-gradient(closest-side, var(--color-accent), transparent);
    filter: blur(2px);
    animation: route-y 4.5s cubic-bezier(0.76, 0, 0.24, 1) infinite;
  }

  @media (min-width: 64rem) {
    .route-spark {
      inset: -0.75rem auto auto 0;
      width: 7rem;
      height: 1.5rem;
      animation-name: route-x;
    }
  }

  @keyframes route-x {
    from {
      left: -7rem;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    to {
      left: 100%;
      opacity: 0;
    }
  }

  @keyframes route-y {
    from {
      top: -4rem;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    to {
      top: 100%;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-spark {
      display: none;
    }
  }
</style>
