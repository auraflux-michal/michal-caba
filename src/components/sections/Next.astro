---
/**
 * "Początek" — Figma 899:525 (5823–6832px, ink): "What’s next?" + closing portrait.
 * Portrait crop reproduces the Figma fill transform of 901:639 (198.67×245.34 frame).
 */
import { Image } from 'astro:assets';
import portrait from '@/assets/images/michal-footer.png';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import SplitLines from '@/components/ui/SplitLines.astro';
---

<section
  id="poczatek"
  aria-labelledby="next-title"
  class="relative overflow-hidden bg-ink text-paper lg:h-[63.0625rem]"
>
  <div class="gutter-x flex h-label items-center">
    <SectionLabel tone="paper">Początek</SectionLabel>
  </div>

  <div class="gutter-x pt-12 lg:px-inset lg:pt-[6.5rem]">
    <h2
      id="next-title"
      data-next-title
      data-reveal="custom"
      class="font-display text-display-tight-sm font-bold uppercase lg:text-display-tight"
    >
      <span class="block" data-next-line>
        What’s
      </span>
      <span class="block" data-next-line>
        next?
      </span>
    </h2>
  </div>

  <div class="gutter-x mt-12 flex flex-col gap-12 lg:absolute lg:top-[32.25rem] lg:bottom-0 lg:left-[60rem] lg:mt-0 lg:w-[25rem] lg:justify-between lg:gap-0 lg:px-0">
    <p class="font-display text-h3-sm font-bold lg:text-h3">
      <SplitLines as="span" class="block">
        Już nie wiem...
      </SplitLines>
      <SplitLines as="span" class="block text-accent" delay={0.15}>
        dlatego jest ciekawie
      </SplitLines>
    </p>

    <figure
      data-reveal
      data-clip-up
      class="relative h-[15.3338rem] w-[12.4167rem] overflow-hidden bg-silver"
    >
      <Image
        src={portrait}
        alt="Michał Caba"
        widths={[240, 480, 720]}
        sizes="(min-width: 1024px) 17vw, 240px"
        class="photo-mono absolute top-[-0.79%] left-[-7.46%] h-[121.1%] w-[119.68%] max-w-none"
      />
    </figure>
  </div>
</section>
