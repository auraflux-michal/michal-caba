---
/**
 * Offer "Mapa Kierunku™" (mockup 2026-10, no Figma frame): sits between "Buduję" (accent)
 * and "Filozofia" (accent), so the accent rail on the left continues the colour band while the
 * ink panel carries the pitch. Left column = 480px, same width as the Build card above it
 * (whose 76px overhang lands on the empty top-right corner of the ink panel, as on the mockup).
 * Copy: src/data/content.ts → `offer`. CTA renders disabled until `offer.bookingUrl` is set.
 */
import { offer } from '@/data/content';
import SplitLines from '@/components/ui/SplitLines.astro';
import ArrowUpRight from '@/assets/icons/arrow-up-right.svg';

const label = 'font-display text-label-sm uppercase lg:text-label';
---

<section
  id="warsztat"
  aria-labelledby="offer-title"
  class="relative grid bg-ink text-paper lg:min-h-[62rem] lg:grid-cols-[30rem_1fr]"
>
  {/* Product rail (accent) */}
  <div class="gutter-x flex flex-col bg-accent pt-10 pb-10 text-ink lg:pb-12">
    <p class:list={[label, 'font-bold']}>{offer.kicker}</p>

    <p class="mt-14 font-display text-[3.25rem] leading-[0.95] font-bold uppercase lg:mt-[4.5rem] lg:text-[4.25rem]">
      <SplitLines as="span" class="block">
        {offer.name[0]}
        <br />
        {offer.name[1]}
        <sup class="ml-0.5 align-super text-[0.25em] font-medium">™</sup>
      </SplitLines>
    </p>
    <p class:list={[label, 'mt-6 lg:mt-8']}>{offer.tagline}</p>

    <div data-reveal data-fade class="mt-16 border-t border-ink pt-6 lg:mt-auto lg:pt-8">
      <p class={label}>{offer.format}</p>
      <p class="mt-3 flex items-baseline gap-2 font-display leading-none font-bold">
        <span class="text-[3.5rem] lg:text-[4rem]">{offer.price}</span>
        <span class="text-label-sm lg:text-label">{offer.currency}</span>
      </p>
    </div>
  </div>

  {/* Pitch (ink) */}
  <div class="gutter-x flex flex-col pt-12 pb-12 lg:pt-10 lg:pb-12">
    <p class:list={[label, 'text-paper/70']}>{offer.eyebrow}</p>

    <h2
      id="offer-title"
      class="mt-8 font-display text-h2-sm font-bold uppercase lg:mt-12 lg:text-h2"
    >
      <SplitLines as="span" class="block">
        {offer.headline[0]}
        <br />
        {offer.headline[1]}
      </SplitLines>
      <SplitLines as="span" class="block text-accent" delay={0.15}>
        {offer.headlineAccent}
      </SplitLines>
    </h2>

    <SplitLines
      class="mt-10 max-w-[42rem] font-body text-body-sm font-semibold lg:mt-12 lg:text-[1.1875rem] lg:leading-[1.875rem]"
      delay={0.2}
    >
      {offer.lead}
    </SplitLines>
    <SplitLines
      class="mt-5 max-w-[42rem] font-body text-body-sm font-medium text-paper/60"
      delay={0.3}
    >
      {offer.body}
    </SplitLines>

    <div class="mt-12 border-t border-line pt-6 lg:mt-14 lg:pt-7">
      <p class:list={[label, 'text-paper/70']}>{offer.outcomesLabel}</p>
      <ol class="mt-4 lg:mt-6">
        {offer.outcomes.map((item) => (
          <li
            data-reveal
            data-fade
            class="grid grid-cols-[3rem_1fr] gap-x-4 gap-y-2 border-b border-line py-6 lg:grid-cols-[4.5rem_13.5rem_1fr] lg:gap-x-0 lg:py-7"
          >
            <span class:list={[label, 'pt-1 text-accent']}>{item.number}</span>
            <h3 class="font-display text-[1.375rem] leading-tight font-bold lg:text-[1.5rem]">
              {item.title}
            </h3>
            <p class="col-start-2 font-body text-body-sm font-medium text-paper/65 lg:col-start-3">
              {item.text}
            </p>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-10 flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between lg:mt-auto lg:pt-10">
      <p class="font-body text-body-sm font-medium text-paper/80">
        {offer.closing[0]}
        <br />
        {offer.closing[1]}
      </p>

      <div class="flex flex-col gap-2 sm:items-start">
        {offer.bookingUrl ? (
          <a
            href={offer.bookingUrl}
            target="_blank"
            rel="noopener"
            class="group inline-flex min-h-14 items-center justify-center gap-3 border border-accent bg-accent px-10 font-display text-label-sm font-bold text-ink uppercase transition-colors duration-300 hover:border-paper hover:bg-paper lg:text-label"
          >
            {offer.cta}
            <span class="sr-only"> (otwiera się w nowej karcie)</span>
            <ArrowUpRight
              aria-hidden="true"
              width={24}
              height={24}
              class="size-5 transition-transform duration-500 ease-out-expo group-hover:translate-x-1 group-hover:-translate-y-1"
            />
          </a>
        ) : (
          <span
            role="link"
            aria-disabled="true"
            class="inline-flex min-h-14 cursor-not-allowed items-center justify-center gap-3 border border-accent/30 bg-accent/30 px-10 font-display text-label-sm font-bold text-paper/60 uppercase lg:text-label"
          >
            {offer.cta}
            <ArrowUpRight
              aria-hidden="true"
              width={24}
              height={24}
              class="size-5 opacity-60 invert"
            />
          </span>
        )}
        {!offer.bookingUrl && (
          <p class="font-body text-[0.875rem] font-medium text-paper/60">{offer.bookingNote}</p>
        )}
      </div>
    </div>
  </div>
</section>
