---
/**
 * "Człowiek": Figma 899:518 (portrait) + 899:517 (paper panel), 800-1600px.
 * Portrait crop reproduces the Figma fill transform (720×800 frame: height 97.11%, top 12.76%,
 * horizontally centred, which is exactly Figma's -45.87% offset). Width follows the photo's own
 * aspect ratio, so it never stretches when the frame is wider than 720:800 (large monitors);
 * min-w-full + object-cover only kick in on ultra-wide frames (crop, never distort).
 * sizes: the image is 86.3rem wide at lg = 96vw (rem scales with the viewport), 1841px past 1920.
 * Copy updated after Figma (longer headline + bio): top padding 160px (Figma 221) keeps the
 * tagline clear of the bio.
 */
import { Image } from 'astro:assets';
import portrait from '@/assets/images/michal-portrait.png';
import Tag from '@/components/ui/Tag.astro';
import SplitLines from '@/components/ui/SplitLines.astro';
---

<section
  id="czlowiek"
  aria-labelledby="about-title"
  class="grid bg-paper text-ink lg:h-[50rem] lg:grid-cols-2"
>
  <figure
    data-parallax-frame
    class="relative aspect-[720/800] overflow-hidden bg-silver lg:aspect-auto lg:h-full"
  >
    {/*
      Static wrapper does the Figma placement (centring via translate, never touched by GSAP);
      the img inside is the parallax target. Ratio comes from the image itself.
    */}
    <div
      class="absolute top-[12.76%] left-1/2 h-[97.11%] min-w-full -translate-x-1/2"
      style={`aspect-ratio: ${portrait.width} / ${portrait.height}`}
    >
      <Image
        src={portrait}
        alt="Michał Caba: portret"
        widths={[720, 1080, 1440, 2048]}
        sizes="(min-width: 1920px) 1841px, (min-width: 1024px) 96vw, 192vw"
        data-parallax-media
        class="photo-mono block size-full max-w-none object-cover"
      />
    </div>
    <Tag data-reveal data-pop class="absolute top-0 right-0 border-t-0 border-r-0">
      Człowiek
    </Tag>
  </figure>

  <div class="gutter-x flex flex-col border-ink py-16 lg:border-l lg:pt-[10rem] lg:pr-inset lg:pb-10 lg:pl-inset">
    <h2 id="about-title" class="font-display text-h2-sm font-bold lg:text-h2">
      <SplitLines as="span" class="block">
        Projektuję marki.
        <br />
        Buduję firmy.
      </SplitLines>
      <SplitLines as="span" class="block text-accent" delay={0.15}>
        Dostrzegam to, czego jeszcze nie ma.
      </SplitLines>
    </h2>

    <SplitLines
      class="mt-10 max-w-[35rem] font-body text-body-sm font-medium lg:text-body"
      delay={0.3}
    >
      Jestem Michał. Od ponad 15 lat poruszam się między strategią, designem, technologią i
      biznesem. Projektuję marki i pomagam ludziom zamieniać pomysły w rzeczy, które naprawdę
      istnieją.
    </SplitLines>

    <p
      data-reveal
      data-fade
      class="mt-16 font-display text-label-sm text-muted uppercase lg:mt-auto lg:text-label"
    >
      Nie robić więcej. Robić lepiej.
    </p>
  </div>
</section>
