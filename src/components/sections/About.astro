---
/**
 * "Człowiek": Figma 899:518 (portrait) + 899:517 (paper panel), 800-1600px.
 * Portrait: full-bleed 1440×1600 photo (720:800, the frame's own ratio), object-cover.
 * Copy updated after Figma (longer headline + bio): top padding 160px (Figma 221) keeps the
 * tagline clear of the bio.
 */
import { copyV1 } from '@/data/copy';
import { Image } from 'astro:assets';
import portrait from '@/assets/images/michal-portrait.webp';
import Tag from '@/components/ui/Tag.astro';
import SplitLines from '@/components/ui/SplitLines.astro';
const copy = Astro.locals.copy ?? copyV1;
---

<section
  id="czlowiek"
  aria-labelledby="about-title"
  class="grid bg-paper text-ink lg:h-[50rem] lg:grid-cols-2"
>
  <figure
    data-parallax-frame
    class="relative aspect-[720/800] overflow-hidden bg-silver lg:aspect-auto lg:h-full"
  >
    {/*
      Full-bleed photo, already graded (monochrome + the red block), so no photo-mono filter.
      Same 720:800 ratio as the mobile frame; on wider desktop frames object-cover crops
      vertically, anchored high to keep the face in view. The parallax zoom covers the drift.
    */}
    <Image
      src={portrait}
      alt="Michał Caba przy wieży z klocków, w dłoni trzyma czerwony klocek"
      widths={[720, 1080, 1440]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      data-parallax-media
      data-parallax-cover
      class="absolute inset-0 size-full object-cover object-[50%_25%]"
    />
    <Tag data-reveal data-pop class="absolute top-0 right-0 border-t-0 border-r-0">
      Człowiek
    </Tag>
  </figure>

  <div class="gutter-x flex flex-col border-ink py-16 lg:border-l lg:pt-[10rem] lg:pr-inset lg:pb-10 lg:pl-inset">
    <h2 id="about-title" class="font-display text-h2-sm font-bold lg:text-h2">
      <SplitLines as="span" class="block">
        {copy.about.headline[0]}
        <br />
        {copy.about.headline[1]}
      </SplitLines>
      <SplitLines as="span" class="block text-accent" delay={0.15}>
        {copy.about.accent}
      </SplitLines>
    </h2>

    <SplitLines
      class="mt-10 max-w-[35rem] font-body text-body-sm font-medium lg:text-body"
      delay={0.3}
    >
      {copy.about.bio}
    </SplitLines>

    <p
      data-reveal
      data-fade
      class="mt-16 font-display text-label-sm text-muted uppercase lg:mt-auto lg:text-label"
    >
      Mniej ruchu. Więcej kierunku.
    </p>
  </div>
</section>
