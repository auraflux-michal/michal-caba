---
/**
 * Document shell: SEO/meta, self-hosted fonts (Astro Fonts API, preloaded + metric fallbacks),
 * motion bootstrap and the global client script.
 */
import { Font, getImage } from 'astro:assets';
import portraitSource from '@/assets/images/michal-portrait.png';
import '@/styles/global.css';
import { site } from '@/data/site';
import { absoluteUrl, assetPath, buildJsonLd, robotsDirective } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const homepage = absoluteUrl('/', Astro.site);
// Branded 1200×630 card rendered at build time (src/pages/og.png.ts)
const ogImageUrl = absoluteUrl('/og.png', Astro.site);
const ogImageAlt = `${site.name}: Widzę potencjał w ludziach. Portret i hasło #1metrDalej.`;
const portrait = await getImage({ src: portraitSource, width: 800, format: 'jpg' });
const portraitUrl = new URL(portrait.src, Astro.site).href;
const jsonLd = buildJsonLd({ canonical, homepage, imageUrl: ogImageUrl, portraitUrl });
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsDirective()} />
    <link rel="icon" href={assetPath('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={assetPath('/apple-touch-icon.png')} />
    <link rel="sitemap" type="application/xml" href={assetPath('/sitemap.xml')} />
    <link rel="me" href={site.socials[0].href} />

    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content={site.person.givenName} />
    <meta property="profile:last_name" content={site.person.familyName} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-manrope" preload />

    {/*
      Layout + motion bootstrap (render-blocking on purpose, tiny): measure the scrollbar for the
      fluid rem scale, and flag the document before first paint so [data-reveal] elements start
      hidden only when animations will actually run.
      Failsafe: reveal everything if the animation bundle has not booted within 3s.
    */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        // Width reserved by the scrollbar gutter (0 with overlay scrollbars). The gutter is set
        // here too because this runs before the stylesheet has been applied.
        root.style.scrollbarGutter = 'stable';
        const setGutter = () =>
          root.style.setProperty(
            '--sbw',
            `${Math.max(0, window.innerWidth - root.getBoundingClientRect().width)}px`,
          );
        setGutter();
        window.addEventListener('resize', setGutter, { passive: true });
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('is-animated');
        setTimeout(() => {
          if (!window.__motionReady) root.classList.remove('is-animated');
        }, 3000);
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only-focusable fixed top-2 left-2 z-[100] bg-accent px-4 py-2 font-display text-ink"
    >
      Przejdź do treści
    </a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
