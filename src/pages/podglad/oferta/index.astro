---
/**
 * Internal preview (not linked, noindex, not in the sitemap): three directions for the offer
 * module "Mapa Kierunku™". Each sits on accent bands standing in for "Buduję" above and
 * "Filozofia" below, its real neighbours. In context (real neighbours): /podglad/oferta/b and /c. Delete /podglad once a direction is chosen.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import IndexMenu from '@/components/layout/IndexMenu.astro';
import OfferManifest from '@/components/sections/offer/OfferManifest.astro';
import OfferSpec from '@/components/sections/offer/OfferSpec.astro';
import OfferRoute from '@/components/sections/offer/OfferRoute.astro';

const variants = [
  {
    id: 'a',
    name: 'A / Manifest',
    note: 'Pytanie jako bohater, 3 kolumny, jasny pas z ceną.',
    Component: OfferManifest,
  },
  {
    id: 'b',
    name: 'B / Karta produktu',
    note: 'Podział 50/50, karta z twardym cieniem w akcencie.',
    Component: OfferSpec,
  },
  {
    id: 'c',
    name: 'C / Trasa',
    note: 'Etapy na jednej linii z płynącym prądem, czerwona płyta z ceną.',
    Component: OfferRoute,
  },
];
---

<BaseLayout title="Podgląd: oferta Mapa Kierunku™" noindex pageType="WebPage">
  <Fragment slot="header">
    <Header />
    <IndexMenu />
  </Fragment>

  <div class="h-header bg-ink"></div>
  {variants.map(({ id, name, note, Component }) => (
    <div id={`kierunek-${id}`} data-variant={id}>
      <div class="gutter-x flex flex-wrap items-baseline justify-between gap-4 bg-paper py-6 text-ink">
        <p class="font-display text-h4-sm font-bold uppercase lg:text-h4">Kierunek {name}</p>
        <p class="font-body text-body-sm font-medium text-ink/70">{note}</p>
      </div>
      <div class="h-24 bg-accent" aria-hidden="true">
        <p class="gutter-x pt-6 font-display text-label-sm text-ink/60 uppercase lg:text-label">
          … Buduję
        </p>
      </div>
      <Component />
      <div class="h-24 bg-accent" aria-hidden="true">
        <p class="gutter-x pt-6 font-display text-label-sm text-ink uppercase lg:text-label">
          Filozofia …
        </p>
      </div>
    </div>
  ))}
</BaseLayout>
